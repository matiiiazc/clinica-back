# --- Django ---
DEBUG=true
SECRET_KEY=pon-aca-la-que-generaste
# Lista separada por comas. Sin dominio propio en dev alcanza con localhost.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostgreSQL) ---
# Opcion A: una sola URL (Neon, Railway, Render, Docker...)
# DATABASE_URL=postgresql://user:pass@host:5432/clinica_back
# Opcion B: variables sueltas para el Postgres local
DB_NAME=clinica_back
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- JWT ---
# Distinta de SECRET_KEY a proposito: asi el JWT de la API no firma la
# cookie de sesion de Django.
JWT_SECRET=pon-otra-distinta-a-secret-key
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS_REMEMBER=30
AUTH_COOKIE_NAME=clinica_auth

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:5173
# Mismos origenes que CORS, pero para que Django acepte el POST con CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Verificacion de email por codigo ---
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_RESEND_SECONDS=60

# --- Anti fuerza bruta (requests por IP cada 15 minutos) ---
DRF_THROTTLE_LOGIN=10
DRF_THROTTLE_VERIFY=10
DRF_THROTTLE_REGISTER=5

# --- Email ---
# Sin SMTP_HOST los codigos se imprimen en la terminal y la API los devuelve
# en dev_code, asi se puede probar el registro sin configurar nada.
CLINICA_NAME=Clínica
EMAIL_FROM=Clínica <no-reply@clinica.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Otros ---
LANGUAGE_CODE=es-ar
TIME_ZONE=America/Argentina/Buenos_Aires
